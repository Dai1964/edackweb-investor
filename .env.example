PORT=3000

# Where enquiries.json lives. Leave unset for local dev (defaults to ./data).
# On Railway this points at the mounted volume so submissions survive a
# redeploy — see deployment notes in README.md.
DATA_DIR=

# Resend (https://resend.com) — sends an email notification to
# edack.david@gmail.com whenever the contact form is submitted. Get this
# from the Resend dashboard. The form still works and still saves to
# enquiries.json without it — email notification is just skipped.
RESEND_API_KEY=
